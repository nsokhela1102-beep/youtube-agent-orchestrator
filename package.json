{
  "name": "sokhela-agents-prompt-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold for orchestrating generic prompt-driven automation agents.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "prepare": "npx playwright install",
    "test": "npx vitest run",
    "start:headless": "cross-env HEADLESS=true node dist/index.js",
    "dev:headless": "cross-env HEADLESS=true npx ts-node src/index.ts",
    "start:concurrent": "cross-env MAX_CONCURRENCY=5 HEADLESS=true node dist/index.js",
    "start:ui": "node dist/ui.js",
    "dev:ui": "npx ts-node src/ui.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "playwright": "^1.54.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4",
    "vitest": "^1.3.0"
  }
}
