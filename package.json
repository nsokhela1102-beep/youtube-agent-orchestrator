{
  "name": "youtube-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold for orchestrating multiple AI-style YouTube automation agents.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "prepare": "npx playwright install",
    "test": "npx vitest run",
    "start:headless": "cross-env HEADLESS=true node dist/index.js",
    "dev:headless": "cross-env HEADLESS=true npx ts-node src/index.ts",
    "start:concurrent": "cross-env MAX_CONCURRENCY=5 HEADLESS=true node dist/index.js"
  },
  "dependencies": {
    "playwright": "^1.54.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4",
    "vitest": "^1.3.0",
    "cross-env": "^7.0.3"
  }
}